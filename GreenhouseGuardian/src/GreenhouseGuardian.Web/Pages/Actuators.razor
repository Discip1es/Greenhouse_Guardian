@page "/actuators"
@inject ApiService ApiService

<MudText Typo="Typo.h5">Actuators Management</MudText>

<MudGrid Spacing="3">
    @foreach (var actuator in actuators)
    {
        <MudItem xs="12" md="6" lg="4">
            <MudCard Elevation="3">
                <MudCardContent>
                    <MudText Typo="Typo.h6">@actuator.Name</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@actuator.Type</MudText>
                    <MudDivider Class="my-2" />
                    <MudText><strong>State:</strong> @actuator.State</MudText>
                    <MudText><strong>Auto Mode:</strong> @(actuator.IsAutoMode ? "Yes" : "No")</MudText>
                    <MudText><strong>Last Command:</strong> @(actuator.LastCommandAt?.ToString("g") ?? "Never")</MudText>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="@(() => ExecuteCommand(actuator.Id, "turn_on"))">Turn ON</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="@(() => ExecuteCommand(actuator.Id, "turn_off"))">Turn OFF</MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
    }
</MudGrid>

@code {
    private List<ActuatorViewModel> actuators = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadActuatorsAsync();
    }

    private async Task LoadActuatorsAsync()
    {
        try
        {
            actuators = await ApiService.GetActuatorsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
    }

    private async Task ExecuteCommand(int actuatorId, string action)
    {
        try
        {
            await ApiService.ExecuteCommandAsync(actuatorId, action);
            await LoadActuatorsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
    }
}
