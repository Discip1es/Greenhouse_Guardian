@page "/alerts"
@inject ApiService ApiService

<MudText Typo="Typo.h5">Alerts</MudText>

<MudTable Items="alerts" Hover="true">
    <HeaderContent>
        <MudTh>Severity</MudTh>
        <MudTh>Title</MudTh>
        <MudTh>Message</MudTh>
        <MudTh>Created At</MudTh>
        <MudTh>Status</MudTh>
        <MudTh>Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>
            <MudChip T="string" Color="@GetSeverityColor(context.Severity)" Size="Size.Small">
                @context.Severity
            </MudChip>
        </MudTd>
        <MudTd>@context.Title</MudTd>
        <MudTd>@context.Message</MudTd>
        <MudTd>@context.CreatedAt.ToString("g")</MudTd>
        <MudTd>
            <MudChip T="string" Color="@(context.IsAcknowledged ? Color.Success : Color.Warning)" Size="Size.Small">
                @(context.IsAcknowledged ? "Acknowledged" : "New")
            </MudChip>
        </MudTd>
        <MudTd>
            @if (!context.IsAcknowledged)
            {
                <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => AcknowledgeAlert(context.Id))">Acknowledge</MudButton>
            }
        </MudTd>
    </RowTemplate>
</MudTable>

@code {
    private List<AlertViewModel> alerts = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAlertsAsync();
    }

    private async Task LoadAlertsAsync()
    {
        try
        {
            alerts = await ApiService.GetAlertsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
    }

    private async Task AcknowledgeAlert(long alertId)
    {
        try
        {
            await ApiService.AcknowledgeAlertAsync(alertId);
            await LoadAlertsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
    }

    private Color GetSeverityColor(string severity)
    {
        return severity.ToLower() switch
        {
            "critical" => Color.Error,
            "warning" => Color.Warning,
            _ => Color.Info
        };
    }
}
