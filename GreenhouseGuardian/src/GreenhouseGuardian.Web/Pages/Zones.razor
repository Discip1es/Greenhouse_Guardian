@page "/zones"
@inject ApiService ApiService

<MudText Typo="Typo.h5">Zones Management</MudText>

<MudGrid Spacing="3">
    @foreach (var zone in zones)
    {
        <MudItem xs="12" md="6">
            <MudCard Elevation="3">
                <MudCardContent>
                    <MudText Typo="Typo.h6">@zone.Name</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@(zone.Description ?? "No description")</MudText>
                    @if (!string.IsNullOrEmpty(zone.PlantProfileName))
                    {
                        <MudText><strong>Plant Profile:</strong> @zone.PlantProfileName</MudText>
                    }
                    <MudDivider Class="my-2" />
                    <MudText><strong>Sensors:</strong> @zone.SensorsCount</MudText>
                    <MudText><strong>Actuators:</strong> @zone.ActuatorsCount</MudText>
                    
                    @if (zone.CurrentReadings.Any())
                    {
                        <MudDivider Class="my-2" />
                        <MudText><strong>Current Readings:</strong></MudText>
                        @foreach (var reading in zone.CurrentReadings)
                        {
                            <MudChip T="string" Size="Size.Small" Class="mr-1">@reading.Key: @reading.Value</MudChip>
                        }
                    }
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Text" OnClick="@(() => EditZone(zone))">Edit</MudButton>
                    <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="@(() => DeleteZone(zone.Id))">Delete</MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
    }
</MudGrid>

@code {
    private List<ZoneViewModel> zones = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadZonesAsync();
    }

    private async Task LoadZonesAsync()
    {
        try
        {
            zones = await ApiService.GetZonesAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
    }

    private void EditZone(ZoneViewModel zone)
    {
        // TODO: Implement edit dialog
    }

    private async Task DeleteZone(string id)
    {
        try
        {
            await ApiService.DeleteZoneAsync(id);
            await LoadZonesAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
    }
}
